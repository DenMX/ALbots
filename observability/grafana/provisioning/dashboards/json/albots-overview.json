          { "matcher": { "id": "byName", "options": "Gold/h" }, "properties": [{ "id": "decimals", "value": 0 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
