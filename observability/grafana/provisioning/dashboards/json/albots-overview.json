            "server": "Server",
            "Value #up": "Up",
            "Value #rip": "Rip",
            "Value #ping": "Ping",
            "Value #gph": "Gold/h",
            "Value #xph": "XP/h",
            "Value #lvl": "Level",
            "Value #xpr": "XP",
            "Value #inv": "Empty inv"
          }
        }}
      ],
