            "ctype": 1,
            "server": 2,
            "Value #up": 3,
            "Value #rip": 4,
            "Value #ping": 5,
            "Value #gph": 6,
            "Value #xph": 7,
            "Value #lvl": 8,
            "Value #xpr": 9,
            "Value #inv": 10
